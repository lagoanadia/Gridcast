# ── GridCast environment variables ──────────────────────────────
# Copy to .env.local and fill in. Never commit real values.

# Owner user id used while auth is not wired (Phase 1, local store).
GRIDCAST_DEV_USER_ID=00000000-0000-0000-0000-000000000001

# Optional: where the Phase 1 JSON store lives (default .data/, or /tmp/gridcast on Vercel).
GRIDCAST_DATA_DIR=

# Publishing: "live" or "dry-run". Default: live once cloud storage exists, dry-run (simulated) before.
# PUBLISHER_MODE=dry-run
# Optional single-account Instagram token (normally you paste it in Cuentas instead).
# INSTAGRAM_ACCESS_TOKEN=

# Shared secret required by /api/cron/* endpoints (scheduler / publisher ticks).
CRON_SECRET=change-me

# Key used to encrypt platform access tokens at rest (32 bytes, base64).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# ── Go live: Supabase (added automatically by the Vercel integration) ──
# POSTGRES_URL enables permanent storage; the Supabase URL + service key enable cloud file storage and real publishing.
POSTGRES_URL=
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Phase 2: publishing intermediary ───────────────────────────
AYRSHARE_API_KEY=

# ── Phase 3: AI ────────────────────────────────────────────────
# Groq (OpenAI-compatible) powers "Sugerir con IA" in Crear. Key from console.groq.com; never commit it.
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile   # optional override
ANTHROPIC_API_KEY=
OPENAI_API_KEY=            # Whisper transcription (if using the API instead of local)

# ── Alerts ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=            # email alerts
ALERT_EMAIL_TO=

# ── Google: sign-in for everyone + YouTube connection (console.cloud.google.com → Credenciales) ──
# With the three of GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET and SESSION_SECRET set, login is required.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the session cookie. Any long random string (falls back to TOKEN_ENCRYPTION_KEY).
SESSION_SECRET=
# Optional: only these emails may sign in (comma separated). Empty = any Google account.
ALLOWED_EMAILS=
# Public address of this app. Optional: otherwise it is read from the request (needed to match the redirect URI).
APP_URL=
